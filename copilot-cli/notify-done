#!/bin/zsh
# notify-done NAME COMMAND [ARG...]: runs the command and says when it has ended, for a test run or a build started by
# hand: a line in agent-status.log (NAME DONE, or NAME FAILED with the exit code) and the same desktop notification a
# session's state gets (cpsig). The command's own output and exit code are kept: notify-done npm-test npm test && ...
#   notify-done jest npx jest src/cart.test.ts
# A pipe or a redirect belongs to the whole line: notify-done jest npx jest a > /tmp/j.txt 2>&1 (its last line,
# notify-done jest: EXIT 0, goes there too). Ctrl+C is reported as FAILED with exit code 130, SIGTERM with 143 and
# SIGHUP (the terminal closed) with 129; either one sent to this script alone is passed on to the command first.
# NAME: letters, digits, . _ -, at most 40 characters. AGENT_STATUS_NOTIFY and COPILOT_HOME as for agent-status.sh.
PATH=$PATH:/usr/bin:/bin:/opt/homebrew/bin:/usr/local/bin
if (( $# < 2 )) || [[ ! $1 =~ '^[A-Za-z0-9._-]{1,40}$' ]]; then
  print -u2 "usage: notify-done NAME COMMAND [ARG...]   (NAME: letters, digits, . _ -, at most 40)"
  exit 2
fi
name=$1
shift
# The command gets Ctrl+C, and a hangup when the terminal closes, too; this script lives on to report how it ended. A
# SIGTERM or SIGHUP sent to this script alone goes on to the command at once (traps_async), so it ends the same way.
# The command's process ids come from $jobstates, and the trap uses builtins only: a trap that starts a process while
# the command ends loses the command's exit code.
zmodload zsh/parameter 2>/dev/null
setopt traps_async
pass_on() {
  local job pid
  for job in ${(v)jobstates}; do for pid in ${${(M)${(s.:.)job}:#*=*}%%=*}; do kill -$1 $pid 2>/dev/null; done; done
}
trap : INT
trap 'pass_on TERM' TERM
trap 'pass_on HUP' HUP
"$@"
code=$?
trap : INT TERM HUP   # from here on a signal no longer cuts the report short
state=DONE
(( code )) && state=FAILED
dir=${COPILOT_HOME:-$HOME/.copilot}
mkdir -p $dir 2>/dev/null
{ print -r -- "$(date +%H:%M:%S)  $name  $state  exit-$code" >> $dir/agent-status.log } 2>/dev/null
notify=${AGENT_STATUS_NOTIFY-$HOME/bin/cpsig}
[[ -n $notify && -x $notify ]] && "$notify" "$name" "$state" </dev/null >/dev/null 2>&1
print -r -- "notify-done $name: EXIT $code"
exit $code
